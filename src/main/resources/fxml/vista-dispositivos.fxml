<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.smarthome.controller.ControladorDispositivos" prefWidth="620" prefHeight="420">
    <top><VBox spacing="8" style="-fx-padding: 20;"><Label text="Dispositivos del hogar" style="-fx-font-size: 22px; -fx-font-weight: bold;"/><Label fx:id="etiquetaMensaje" text=""/></VBox></top>
    <center><ListView fx:id="listaDispositivos" BorderPane.alignment="CENTER"/></center>
    <bottom><HBox spacing="10" style="-fx-padding: 16;"><Button text="Agregar" onAction="#agregarDispositivo"/><Button text="Eliminar seleccionado" onAction="#eliminarDispositivo"/></HBox></bottom>
</BorderPane>
