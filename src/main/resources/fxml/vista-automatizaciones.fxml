<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.smarthome.controller.ControladorAutomatizaciones" prefWidth="620" prefHeight="420">
    <top>
        <VBox spacing="8" style="-fx-padding: 20;">
            <HBox spacing="8">
                <Button text="Inicio" onAction="#irAInicio" />
                <Button text="Dispositivos" onAction="#irADispositivos" />
                <Button text="Automatizaciones" onAction="#irAAutomatizaciones" />
                <Button text="Historial" onAction="#irAHistorial" />
            </HBox>
            <Label text="Automatizaciones" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label fx:id="etiquetaMensaje" text=""/>
        </VBox>
    </top>
    <center><ListView fx:id="listaReglas" BorderPane.alignment="CENTER"/></center>
    <bottom>
        <VBox spacing="8" style="-fx-padding: 16;">
            <HBox spacing="10">
                <Button text="Crear regla"
                        onAction="#crearRegla" />
                <Button text="Cambiar estrategia"
                        onAction="#cambiarEstrategia" />
            </HBox>
            <Button text="Activar / desactivar"
                    onAction="#cambiarEstadoRegla" />
        </VBox>
    </bottom>
</BorderPane>
