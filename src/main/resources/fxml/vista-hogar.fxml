<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.smarthome.controller.ControladorHogar" spacing="14" alignment="CENTER">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
    <HBox spacing="8" alignment="CENTER">
        <Button text="Inicio" onAction="#irAInicio" />
        <Button text="Dispositivos" onAction="#irADispositivos" />
        <Button text="Automatizaciones" onAction="#irAAutomatizaciones" />
        <Button text="Historial" onAction="#irAHistorial" />
    </HBox>
    <Label text="Hogares Inteligentes" styleClass="title" />
    <Label fx:id="etiquetaEstado" text="Estado de la luz" />
    <HBox spacing="8" alignment="CENTER">
        <Button text="Encender luz" onAction="#encender" />
        <Button text="Apagar luz" onAction="#apagar" />
    </HBox>
    <Label text="Estrategia para la luz de la sala" />
    <ComboBox fx:id="selectorEstrategia" prefWidth="300" />
    <HBox spacing="8" alignment="CENTER">
        <Button text="Simular movimiento" onAction="#simularMovimiento" />
        <Button text="Simular habitación vacía" onAction="#simularAusencia" />
    </HBox>
    <Label fx:id="etiquetaMensaje" text="Listo" wrapText="true" />
</VBox>
